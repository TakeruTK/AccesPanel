                  <span>Empresa</span>
                  <input name="company" type="text" value="<%= filters.company %>" placeholder="MetalSur" />
                </label>
                <label>
                  <span>Responsable</span>
                  <input name="hostName" type="text" value="<%= filters.hostName %>" placeholder="Daniela Rojas" />
