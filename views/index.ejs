                  <label>
                    <span>Salida estimada</span>
                    <input id="request-exit-at" name="desiredExitAt" type="datetime-local" required />
                  </label>
                </div>
                <label class="full-width-label">
                  <span>Observaciones del operador</span>
                  <textarea id="request-operator-notes" name="operatorNotes" rows="3" placeholder="Indica por que se eleva la solicitud y cualquier respaldo disponible."></textarea>
                </label>
                <div class="action-row">
                  <button id="request-submit-button" class="danger-button" type="submit">Enviar solicitud urgente</button>
                </div>
              </form>
            </article>
          </div>
        </section>
      <% } else if (ui.sections.tickets) { %>
