<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="<%= csrfToken %>" />
    <title>Fix Access | Dashboard</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="page-shell">
      <header class="app-topbar">
        <div>
          <p class="eyebrow">Sesion activa</p>
          <h2><%= ui.heading %></h2>
        </div>
        <div class="app-topbar-actions">
          <div class="user-badge">
            <strong><%= currentUser.fullName %></strong>
            <span><%= currentRole ? currentRole.name : currentUser.roleCode %> - @<%= currentUser.username %></span>
          </div>
          <form method="post" action="/logout">
            <input type="hidden" name="csrfToken" value="<%= csrfToken %>" />
            <button class="logout-button" type="submit">Cerrar sesion</button>
          </form>
        </div>
      </header>

      <header class="hero">
        <div class="hero-copy">
          <p class="eyebrow"><%= currentRole ? currentRole.name : currentUser.roleCode %></p>
          <h1><%= ui.heading %></h1>
          <p class="lead"><%= ui.description %></p>
          <div class="hero-badges">
            <span>Operacion actual: <strong><%= operationWindow.label %></strong></span>
            <span>Usuario actual: <strong><%= currentUser.username %></strong></span>
          </div>
        </div>
        <div class="hero-panel">
          <div class="hero-panel-label">Modulos habilitados</div>
          <ul class="hero-panel-list">
            <% ui.modules.forEach((module) => { %>
              <li><%= module %></li>
            <% }) %>
          </ul>
        </div>
      </header>

      <% if (noticeMessage || errorMessage) { %>
        <section class="flash-stack">
          <% if (noticeMessage) { %>
            <article class="flash-card flash-success"><%= noticeMessage %></article>
          <% } %>
          <% if (errorMessage) { %>
            <article class="flash-card flash-error"><%= errorMessage %></article>
          <% } %>
        </section>
      <% } %>

      <section class="summary-grid">
        <% summaryCards.forEach((card) => { %>
          <article class="summary-card summary-<%= card.tone %>">
            <p><%= card.label %></p>
            <strong><%= card.value %></strong>
          </article>
        <% }) %>
      </section>

      <section class="panel-section" id="account-security">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Mi cuenta</p>
            <h2>Credenciales y sesion</h2>
          </div>
          <p class="section-copy">
            Politica actual: <strong><%= passwordPolicySummary %></strong>. La sesion expira tras
            <strong><%= systemSettings.SECURITY.sessionTimeoutMinutes %> minutos</strong> de inactividad.
          </p>
        </div>

        <div class="dual-layout account-security-layout">
          <article class="tool-panel">
            <div class="tool-header">
              <div>
                <p class="eyebrow">Cambio de contrasena</p>
                <h3>Actualizar acceso personal</h3>
              </div>
            </div>

            <form class="stack-form" method="post" action="/account/password">
              <div class="form-grid compact-three-grid">
                <label>
                  <span>Contrasena actual</span>
                  <input name="currentPassword" type="password" autocomplete="current-password" required />
                </label>
                <label>
                  <span>Nueva contrasena</span>
                  <input name="newPassword" type="password" autocomplete="new-password" required />
                </label>
                <label>
                  <span>Confirmar nueva contrasena</span>
                  <input name="confirmPassword" type="password" autocomplete="new-password" required />
                </label>
              </div>
              <div class="action-row">
                <button class="primary-action" type="submit">Actualizar contrasena</button>
              </div>
            </form>
          </article>

          <article class="tool-panel">
            <div class="tool-header">
              <div>
                <p class="eyebrow">Estado de seguridad</p>
                <h3>Politica activa del sistema</h3>
              </div>
            </div>

            <div class="info-stack">
              <div class="info-chip">
                <span>Intentos maximos de login</span>
                <strong><%= systemSettings.SECURITY.maxLoginAttempts %></strong>
              </div>
              <div class="info-chip">
                <span>Bloqueo temporal</span>
                <strong><%= systemSettings.SECURITY.lockoutMinutes %> min</strong>
              </div>
              <div class="info-chip">
                <span>Cookies seguras</span>
                <strong><%= systemSettings.SECURITY.secureCookies ? "Activadas" : "Desactivadas" %></strong>
              </div>
              <div class="info-chip">
                <span>Credenciales demo visibles</span>
                <strong><%= systemSettings.SECURITY.showDemoCredentials ? "Si" : "No" %></strong>
              </div>
            </div>
          </article>
        </div>
      </section>

      <% if (ui.sections.userAdmin) { %>
        <section class="panel-section" id="admin-tools">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Herramientas del administrador</p>
              <h2>Gestion de usuarios y cuentas</h2>
            </div>
            <p class="section-copy">
              Solo el administrador puede crear usuarios, asignar roles y bloquear o reactivar cuentas del sistema.
            </p>
          </div>

          <div class="dual-layout">
            <article class="tool-panel">
              <div class="tool-header">
                <div>
                  <p class="eyebrow">Nuevo usuario</p>
                  <h3>Alta de cuenta</h3>
                </div>
              </div>

              <p class="panel-copy">
                Crea administradores, creadores, verificadores u operadores con credenciales seguras y rol asignado.
              </p>

              <form class="stack-form" method="post" action="/admin/users">
                <div class="form-grid">
                  <label>
                    <span>Nombre completo</span>
                    <input name="fullName" type="text" value="<%= adminForm.fields.fullName %>" required />
                  </label>
                  <label>
                    <span>Usuario</span>
                    <input name="username" type="text" value="<%= adminForm.fields.username %>" placeholder="operador-norte" required />
                  </label>
                  <label>
                    <span>Correo</span>
                    <input name="email" type="email" value="<%= adminForm.fields.email %>" placeholder="usuario@empresa.cl" />
                  </label>
                  <label>
                    <span>Contrasena temporal</span>
                    <input name="password" type="text" placeholder="clave123" required />
                  </label>
                  <label>
                    <span>Rol</span>
                    <select name="roleCode" required>
                      <% availableRoles.forEach((role) => { %>
                        <option value="<%= role.code %>" <%= adminForm.fields.roleCode === role.code ? "selected" : "" %>>
                          <%= role.name %>
                        </option>
                      <% }) %>
                    </select>
                  </label>
                </div>

                <div class="action-row">
                  <button class="primary-action" type="submit">Crear usuario</button>
                </div>
              </form>
            </article>

            <article class="tool-panel">
              <div class="tool-header">
                <div>
                  <p class="eyebrow">Cuentas registradas</p>
                  <h3>Usuarios del sistema</h3>
                </div>
                <span class="inline-badge"><%= managedUsers.length %> cuentas</span>
              </div>

              <div class="tool-card-grid">
                <% managedUsers.forEach((account) => { %>
                  <article class="user-card">
                    <div class="request-topline">
                      <strong>@<%= account.username %></strong>
                      <span class="status-pill status-<%= account.statusClass %>"><%= account.statusLabel %></span>
                    </div>
                    <h3><%= account.fullName %></h3>
                    <p class="request-meta">Rol: <strong><%= account.roleName %></strong></p>
                    <p class="request-meta">Correo: <strong><%= account.email %></strong></p>
                    <p class="request-time">
                      Creado por <strong><%= account.createdBy %></strong> el <strong><%= account.createdAtLabel %></strong>
                    </p>
                    <div class="request-actions">
                      <% if (account.username === currentUser.username) { %>
                        <span class="secondary-link static-chip">Sesion actual</span>
                      <% } else { %>
                        <form method="post" action="/admin/users/<%= encodeURIComponent(account.username) %>/toggle-status">
                          <button class="<%= account.statusCode === 'ACTIVE' ? 'danger-button' : 'secondary-button' %>" type="submit">
                            <%= account.statusCode === "ACTIVE" ? "Bloquear cuenta" : "Reactivar cuenta" %>
                          </button>
                        </form>
                      <% } %>
                    </div>
                  </article>
                <% }) %>
              </div>
            </article>
          </div>

          <div class="stack-block" id="admin-settings">
            <div class="tool-header">
              <div>
                <p class="eyebrow">Configuraciones del administrador</p>
                <h3>Reglas operativas, seguridad y correo entrante</h3>
              </div>
            </div>

            <div class="admin-settings-grid">
              <article class="tool-panel">
                <div class="tool-header">
                  <div>
                    <p class="eyebrow">Seguridad</p>
                    <h3>Politica de acceso</h3>
                  </div>
                </div>
                <form class="stack-form" method="post" action="/admin/settings/security">
                  <div class="form-grid compact-three-grid">
                    <label>
                      <span>Timeout de sesion (min)</span>
                      <input name="sessionTimeoutMinutes" type="number" min="5" value="<%= securityForm.sessionTimeoutMinutes %>" required />
                    </label>
                    <label>
                      <span>Maximo intentos</span>
                      <input name="maxLoginAttempts" type="number" min="3" value="<%= securityForm.maxLoginAttempts %>" required />
                    </label>
                    <label>
                      <span>Bloqueo (min)</span>
                      <input name="lockoutMinutes" type="number" min="1" value="<%= securityForm.lockoutMinutes %>" required />
                    </label>
                    <label>
                      <span>Largo minimo clave</span>
                      <input name="minPasswordLength" type="number" min="8" value="<%= securityForm.minPasswordLength %>" required />
                    </label>
                  </div>
                  <div class="toggle-grid">
                    <label class="toggle-card">
                      <input name="requireUppercase" type="checkbox" <%= securityForm.requireUppercase ? "checked" : "" %> />
                      <span>Exigir mayuscula</span>
                    </label>
                    <label class="toggle-card">
                      <input name="requireLowercase" type="checkbox" <%= securityForm.requireLowercase ? "checked" : "" %> />
                      <span>Exigir minuscula</span>
                    </label>
                    <label class="toggle-card">
                      <input name="requireDigit" type="checkbox" <%= securityForm.requireDigit ? "checked" : "" %> />
                      <span>Exigir numero</span>
                    </label>
                    <label class="toggle-card">
                      <input name="requireSpecialChar" type="checkbox" <%= securityForm.requireSpecialChar ? "checked" : "" %> />
                      <span>Exigir simbolo</span>
                    </label>
                    <label class="toggle-card">
                      <input name="secureCookies" type="checkbox" <%= securityForm.secureCookies ? "checked" : "" %> />
                      <span>Cookies seguras</span>
                    </label>
                    <label class="toggle-card">
                      <input name="showDemoCredentials" type="checkbox" <%= securityForm.showDemoCredentials ? "checked" : "" %> />
                      <span>Mostrar credenciales demo</span>
                    </label>
                  </div>
                  <div class="action-row">
                    <button class="primary-action" type="submit">Guardar seguridad</button>
                  </div>
                </form>
              </article>

              <article class="tool-panel">
                <div class="tool-header">
                  <div>
                    <p class="eyebrow">Operacion</p>
                    <h3>Ventanas del control de acceso</h3>
                  </div>
                </div>
                <form class="stack-form" method="post" action="/admin/settings/operation">
                  <div class="form-grid compact-three-grid">
                    <label>
                      <span>Tolerancia ingreso anticipado (min)</span>
                      <input name="earlyEntryToleranceMinutes" type="number" min="0" value="<%= operationSettingsForm.earlyEntryToleranceMinutes %>" required />
                    </label>
                    <label>
                      <span>Tolerancia salida tardia (min)</span>
                      <input name="lateExitToleranceMinutes" type="number" min="0" value="<%= operationSettingsForm.lateExitToleranceMinutes %>" required />
                    </label>
                    <label>
                      <span>Duracion por defecto (hrs)</span>
                      <input name="defaultVisitDurationHours" type="number" min="1" value="<%= operationSettingsForm.defaultVisitDurationHours %>" required />
                    </label>
                  </div>
                  <div class="toggle-grid">
                    <label class="toggle-card">
                      <input name="strictRutValidation" type="checkbox" <%= operationSettingsForm.strictRutValidation ? "checked" : "" %> />
                      <span>Validar RUT estrictamente</span>
                    </label>
                  </div>
                  <div class="action-row">
                    <button class="primary-action" type="submit">Guardar operacion</button>
                  </div>
                </form>
              </article>

              <article class="tool-panel">
                <div class="tool-header">
                  <div>
                    <p class="eyebrow">Correo entrante</p>
                    <h3>Reglas de ingreso automatico</h3>
                  </div>
                </div>
                <form class="stack-form" method="post" action="/admin/settings/email-intake">
                  <div class="toggle-grid">
                    <label class="toggle-card">
                      <input name="intakeEnabled" type="checkbox" <%= emailSettingsForm.intakeEnabled ? "checked" : "" %> />
                      <span>Habilitar bandeja entrante</span>
                    </label>
                    <label class="toggle-card">
                      <input name="requireAttachment" type="checkbox" <%= emailSettingsForm.requireAttachment ? "checked" : "" %> />
                      <span>Exigir adjunto</span>
                    </label>
                  </div>
                  <div class="form-grid">
                    <label>
                      <span>Tipos MIME permitidos</span>
                      <input name="acceptedFileTypes" type="text" value="<%= emailSettingsForm.acceptedFileTypes %>" required />
                    </label>
                    <label>
                      <span>Webhook token</span>
                      <input name="webhookToken" type="text" value="<%= emailSettingsForm.webhookToken %>" placeholder="token-seguro-correo" />
                    </label>
                  </div>
                  <div class="action-row">
                    <button class="primary-action" type="submit">Guardar correo entrante</button>
                  </div>
                </form>
              </article>
            </div>
          </div>
        </section>
      <% } %>

      <% if (ui.sections.creatorTools) { %>
        <section class="panel-section" id="creator-tools">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Herramientas del creador</p>
              <h2>Creacion, correccion y respuesta de tickets</h2>
            </div>
            <p class="section-copy">
              Puedes crear tickets manuales, tomar solicitudes del operador y corregir tickets observados antes de reenviarlos.
            </p>
          </div>

          <div class="dual-layout creator-mail-layout">
            <article class="tool-panel">
              <div class="tool-header">
                <div>
                  <p class="eyebrow">Correo entrante</p>
                  <h3>Registrar nueva solicitud por email</h3>
                </div>
                <span class="inline-badge">
                  <%= emailRequests.filter((request) => ["RECEIVED", "IN_REVIEW"].includes(request.statusCode)).length %> por atender
                </span>
              </div>

              <p class="panel-copy">
                Puedes dejar trazado el correo original, adjuntar respaldos y convertirlo despues a ticket formal.
              </p>

              <form
                class="stack-form"
                method="post"
                action="/creator/email-intake?csrfToken=<%= encodeURIComponent(csrfToken) %>"
                enctype="multipart/form-data"
              >
                <div class="form-grid">
                  <label>
                    <span>Nombre remitente</span>
                    <input name="senderName" type="text" value="<%= emailIntakeForm.fields.senderName %>" placeholder="Marta Salgado" />
                  </label>
                  <label>
                    <span>Correo remitente</span>
                    <input name="senderEmail" type="email" value="<%= emailIntakeForm.fields.senderEmail %>" placeholder="marta@empresa.cl" required />
                  </label>
                  <label>
                    <span>Asunto</span>
                    <input name="subject" type="text" value="<%= emailIntakeForm.fields.subject %>" required />
                  </label>
                  <label>
                    <span>Empresa</span>
                    <input name="companyName" type="text" value="<%= emailIntakeForm.fields.companyName %>" />
                  </label>
                  <label>
                    <span>RUT solicitado</span>
                    <input name="requestedRut" type="text" value="<%= emailIntakeForm.fields.requestedRut %>" />
                  </label>
                  <label>
                    <span>Nombre</span>
                    <input name="requestedFirstName" type="text" value="<%= emailIntakeForm.fields.requestedFirstName %>" />
                  </label>
                  <label>
                    <span>Apellido</span>
                    <input name="requestedLastName" type="text" value="<%= emailIntakeForm.fields.requestedLastName %>" />
                  </label>
                  <label>
                    <span>Responsable interno</span>
                    <input name="hostName" type="text" value="<%= emailIntakeForm.fields.hostName %>" />
                  </label>
                  <label>
                    <span>Actividad</span>
                    <input name="activityDescription" type="text" value="<%= emailIntakeForm.fields.activityDescription %>" />
                  </label>
                  <label>
                    <span>Entrada estimada</span>
                    <input name="desiredEntryAt" type="datetime-local" value="<%= emailIntakeForm.fields.desiredEntryAt %>" />
                  </label>
                  <label>
                    <span>Salida estimada</span>
                    <input name="desiredExitAt" type="datetime-local" value="<%= emailIntakeForm.fields.desiredExitAt %>" />
                  </label>
                  <label>
                    <span>Adjuntos</span>
                    <input name="attachments" type="file" multiple />
                  </label>
                </div>

                <label class="full-width-label">
                  <span>Cuerpo del correo</span>
                  <textarea name="body" rows="5" required><%= emailIntakeForm.fields.body %></textarea>
                </label>

                <label class="full-width-label">
                  <span>Notas internas</span>
                  <textarea name="notes" rows="2"><%= emailIntakeForm.fields.notes %></textarea>
                </label>

                <div class="action-row">
                  <button class="primary-action" type="submit">Guardar correo entrante</button>
                </div>
              </form>
            </article>

            <article class="tool-panel">
              <div class="tool-header">
                <div>
                  <p class="eyebrow">Bandeja de correos</p>
                  <h3>Solicitudes pendientes y convertidas</h3>
                </div>
              </div>

              <div class="tool-card-grid">
                <% emailRequests.forEach((request) => { %>
                  <article class="request-card request-card-expanded">
                    <div class="request-topline">
                      <strong><%= request.intakeCode %></strong>
                      <span class="status-pill status-<%= request.statusClass %>"><%= request.statusLabel %></span>
                    </div>
                    <h3><%= request.subject %></h3>
                    <p class="request-meta"><%= request.senderName || "Sin nombre" %> - <%= request.senderEmail %></p>
                    <p class="request-meta">
                      Solicitud: <%= request.requestedFullName || "Sin persona" %><% if (request.requestedRut) { %> - <%= request.requestedRut %><% } %>
                    </p>
                    <p class="request-meta">Empresa: <%= request.companyName || "Sin empresa" %></p>
                    <p class="request-meta">Responsable: <%= request.hostName || "Sin responsable" %></p>
                    <p class="request-meta">Horario: <%= request.desiredEntryLabel %> a <%= request.desiredExitLabel %></p>
                    <p class="request-notes"><strong>Actividad:</strong> <%= request.activityDescription || "Sin detalle" %></p>
                    <p class="request-notes"><strong>Cuerpo:</strong> <%= request.body %></p>
                    <% if (request.notes) { %>
                      <p class="request-response"><strong>Seguimiento:</strong> <%= request.notes %></p>
                    <% } %>
                    <% if (request.relatedTicketCode) { %>
                      <p class="request-response"><strong>Ticket relacionado:</strong> <%= request.relatedTicketCode %></p>
                    <% } %>
                    <% const requestAttachments = emailAttachmentsByRequestId[request.id] || []; %>
                    <% if (requestAttachments.length) { %>
                      <div class="attachment-list">
                        <% requestAttachments.forEach((attachment) => { %>
                          <a class="attachment-chip" href="<%= attachment.downloadUrl %>">
                            <span><%= attachment.originalName %></span>
                            <strong><%= attachment.sizeLabel %></strong>
                          </a>
                        <% }) %>
                      </div>
                    <% } %>
                    <div class="request-actions wrap-actions">
                      <% if (request.statusCode === "RECEIVED") { %>
                        <form method="post" action="/creator/email-intake/<%= request.intakeCode %>/take">
                          <button class="secondary-button" type="submit">Tomar correo</button>
                        </form>
                      <% } %>
                      <% if (request.statusCode !== "DISMISSED") { %>
                        <a class="secondary-link" href="/dashboard?emailIntakeCode=<%= request.intakeCode %>#creator-tools">Usar datos para ticket</a>
                      <% } %>
                    </div>
                    <% if (!["DISMISSED", "CONVERTED_TO_TICKET"].includes(request.statusCode)) { %>
                      <form class="stack-form compact-form" method="post" action="/creator/email-intake/<%= request.intakeCode %>/dismiss">
                        <label class="full-width-label">
                          <span>Motivo de descarte</span>
                          <textarea name="dismissNotes" rows="2" placeholder="Ejemplo: correo duplicado o sin respaldo suficiente."></textarea>
                        </label>
                        <div class="action-row">
                          <button class="danger-button" type="submit">Descartar correo</button>
                        </div>
                      </form>
                    <% } %>
                  </article>
                <% }) %>
              </div>
            </article>
          </div>

          <div class="dual-layout">
            <article class="tool-panel">
              <div class="tool-header">
                <div>
                  <p class="eyebrow"><%= creatorForm.isEditingObserved ? "Ticket observado" : "Nuevo ticket" %></p>
                  <h3><%= creatorForm.isEditingObserved ? "Correccion y reenvio" : "Formulario de creacion" %></h3>
                </div>
                <% if (creatorForm.sourceRequest) { %>
                  <span class="inline-badge">Origen: <%= creatorForm.sourceRequest.requestCode %></span>
                <% } %>
                <% if (creatorForm.observedTicket) { %>
                  <span class="inline-badge">Editando: <%= creatorForm.observedTicket.ticketCode %></span>
                <% } %>
                <% if (creatorForm.sourceEmail) { %>
                  <span class="inline-badge">Correo: <%= creatorForm.sourceEmail.intakeCode %></span>
                <% } %>
              </div>

              <form class="stack-form" method="post" action="/creator/tickets">
                <input type="hidden" name="requestCode" value="<%= creatorForm.requestCode %>" />
                <input type="hidden" name="ticketCode" value="<%= creatorForm.ticketCode %>" />
                <input type="hidden" name="emailIntakeCode" value="<%= creatorForm.emailIntakeCode %>" />

                <% if (creatorForm.sourceEmail) { %>
                  <article class="embedded-note-card">
                    <p class="request-meta">
                      Solicitud tomada desde el correo <strong><%= creatorForm.sourceEmail.intakeCode %></strong> de
                      <strong><%= creatorForm.sourceEmail.senderEmail %></strong>.
                    </p>
                    <% const sourceEmailAttachments = emailAttachmentsByRequestId[creatorForm.sourceEmail.id] || []; %>
                    <% if (sourceEmailAttachments.length) { %>
                      <div class="attachment-list">
                        <% sourceEmailAttachments.forEach((attachment) => { %>
                          <a class="attachment-chip" href="<%= attachment.downloadUrl %>">
                            <span><%= attachment.originalName %></span>
                            <strong><%= attachment.sizeLabel %></strong>
                          </a>
                        <% }) %>
                      </div>
                    <% } %>
                  </article>
                <% } %>

                <div class="form-grid">
                  <label>
                    <span>RUT</span>
                    <input name="rut" type="text" value="<%= creatorForm.fields.rut %>" required />
                  </label>
                  <label>
                    <span>Empresa</span>
                    <input name="company" type="text" value="<%= creatorForm.fields.company %>" required />
                  </label>
                  <label>
                    <span>Nombre</span>
                    <input name="firstName" type="text" value="<%= creatorForm.fields.firstName %>" required />
                  </label>
                  <label>
                    <span>Apellido</span>
                    <input name="lastName" type="text" value="<%= creatorForm.fields.lastName %>" required />
                  </label>
                  <label>
                    <span>Responsable interno</span>
                    <input name="hostName" type="text" value="<%= creatorForm.fields.hostName %>" required />
                  </label>
                  <label>
                    <span>Actividad</span>
                    <input name="activityDescription" type="text" value="<%= creatorForm.fields.activityDescription %>" required />
                  </label>
                  <label>
                    <span>Entrada estimada</span>
                    <input name="scheduledEntryAt" type="datetime-local" value="<%= creatorForm.fields.scheduledEntryAt %>" required />
                  </label>
                  <label>
                    <span>Salida estimada</span>
                    <input name="scheduledExitAt" type="datetime-local" value="<%= creatorForm.fields.scheduledExitAt %>" required />
                  </label>
                </div>

                <label class="full-width-label">
                  <span>Notas del ticket</span>
                  <textarea name="ticketNotes" rows="4"><%= creatorForm.fields.ticketNotes %></textarea>
                </label>

                <div class="action-row">
                  <button class="primary-action" type="submit">
                    <%= creatorForm.isEditingObserved ? "Corregir y reenviar a verificacion" : "Crear ticket pendiente de verificacion" %>
                  </button>
                  <% if (creatorForm.requestCode || creatorForm.ticketCode) { %>
                    <a class="secondary-link" href="/dashboard#creator-tools">Limpiar formulario</a>
                  <% } %>
                </div>
              </form>
            </article>

            <article class="tool-panel">
              <div class="tool-header">
                <div>
                  <p class="eyebrow">Solicitudes del operador</p>
                  <h3>Bandeja para respuesta</h3>
                </div>
                <span class="inline-badge">
                  <%= allRequests.filter((request) => ["PENDIENTE_RESPUESTA", "EN_REVISION"].includes(request.statusCode)).length %> pendientes
                </span>
              </div>

              <div class="tool-card-grid">
                <% operatorRequests.forEach((request) => { %>
                  <article class="request-card request-card-expanded">
                    <div class="request-topline">
                      <strong><%= request.requestCode %></strong>
                      <span class="status-pill status-<%= request.statusClass %>"><%= request.statusLabel %></span>
                    </div>
                    <h3><%= request.fullName %></h3>
                    <p class="request-meta"><%= request.rut %> - <%= request.company %></p>
                    <p class="request-meta">Responsable: <%= request.hostName %></p>
                    <p class="request-meta">Horario solicitado: <%= request.desiredEntryLabel %> a <%= request.desiredExitLabel %></p>
                    <p class="request-notes"><strong>Actividad:</strong> <%= request.activityDescription %></p>
                    <p class="request-notes"><strong>Detalle:</strong> <%= request.notes %></p>
                    <% if (request.relatedTicketCode) { %>
                      <p class="request-response"><strong>Ticket relacionado:</strong> <%= request.relatedTicketCode %></p>
                    <% } %>
                    <% if (request.responseNotes) { %>
                      <p class="request-response"><strong>Seguimiento:</strong> <%= request.responseNotes %></p>
                    <% } %>
                    <div class="request-actions">
                      <% if (request.statusCode === "PENDIENTE_RESPUESTA") { %>
                        <form method="post" action="/creator/requests/<%= request.requestCode %>/take">
                          <button class="secondary-button" type="submit">Tomar solicitud</button>
                        </form>
                      <% } %>
                      <a class="secondary-link" href="/dashboard?requestCode=<%= request.requestCode %>#creator-tools">Usar datos para ticket</a>
                    </div>
                    <% if (!["RECHAZADA", "CERRADA"].includes(request.statusCode)) { %>
                      <form class="stack-form compact-form" method="post" action="/creator/requests/<%= request.requestCode %>/reject">
                        <label class="full-width-label">
                          <span>Motivo de rechazo</span>
                          <textarea name="responseNotes" rows="2" placeholder="Ejemplo: falta respaldo del servicio o responsable interno."></textarea>
                        </label>
                        <div class="action-row">
                          <button class="danger-button" type="submit">Rechazar solicitud</button>
                        </div>
                      </form>
                    <% } %>
                  </article>
                <% }) %>
              </div>
            </article>
          </div>

          <% if (observedTickets.length) { %>
            <div class="stack-block">
              <div class="tool-header">
                <div>
                  <p class="eyebrow">Correcciones pendientes</p>
                  <h3>Tickets observados por el verificador</h3>
                </div>
              </div>
              <div class="tool-card-grid">
                <% observedTickets.forEach((ticket) => { %>
                  <article class="mini-ticket-card">
                    <div class="request-topline">
                      <strong><%= ticket.ticketCode %></strong>
                      <span class="status-pill status-<%= ticket.statusClass %>"><%= ticket.statusLabel %></span>
                    </div>
                    <p class="request-meta"><%= ticket.person.fullName %> - <%= ticket.person.rut %></p>
                    <p class="request-meta">Empresa: <%= ticket.company %></p>
                    <p class="request-notes"><%= ticket.verificationNotes || ticket.ticketNotes %></p>
                    <div class="request-actions">
                      <a class="secondary-link" href="/dashboard?ticketCode=<%= ticket.ticketCode %><%= ticket.relatedRequestCode ? `&requestCode=${ticket.relatedRequestCode}` : "" %>#creator-tools">
                        Corregir ticket
                      </a>
                    </div>
                  </article>
                <% }) %>
              </div>
            </div>
          <% } %>
        </section>
      <% } %>

      <% if (ui.sections.verifierTools) { %>
        <section class="panel-section" id="verification-tools">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Herramientas del verificador</p>
              <h2>Cola de revision y decision</h2>
            </div>
            <p class="section-copy">
              Cada decision actualiza el estado del ticket y deja trazabilidad para el creador y el operador.
            </p>
          </div>

          <div class="verification-grid">
            <article class="tool-panel">
              <div class="tool-header">
                <div>
                  <p class="eyebrow">Pendientes</p>
                  <h3>Tickets por resolver</h3>
                </div>
              </div>

              <% if (!verificationQueue.length) { %>
                <div class="empty-state">
                  <strong>No hay tickets pendientes de revision.</strong>
                  <p>La cola del verificador esta al dia.</p>
                </div>
              <% } else { %>
                <div class="tool-card-grid">
                  <% verificationQueue.forEach((ticket) => { %>
                    <article class="verification-card">
                      <div class="request-topline">
                        <strong><%= ticket.ticketCode %></strong>
                        <span class="status-pill status-<%= ticket.statusClass %>"><%= ticket.statusLabel %></span>
                      </div>
                      <h3><%= ticket.person.fullName %></h3>
                      <p class="request-meta"><%= ticket.person.rut %> - <%= ticket.company %></p>
                      <p class="request-meta">Responsable: <%= ticket.hostName %></p>
                      <p class="request-meta">Horario: <%= ticket.scheduledEntryLabel %> a <%= ticket.scheduledExitLabel %></p>
                      <p class="request-notes"><strong>Actividad:</strong> <%= ticket.activityDescription %></p>
                      <p class="request-notes"><strong>Notas:</strong> <%= ticket.verificationNotes || ticket.ticketNotes || "Sin notas" %></p>

                      <form class="stack-form compact-form" method="post" action="/verifier/tickets/<%= ticket.ticketCode %>/decision">
                        <label class="full-width-label">
                          <span>Comentario del verificador</span>
                          <textarea name="notes" rows="3" placeholder="Ejemplo: Documentacion completa y area disponible."></textarea>
                        </label>
                        <div class="decision-row">
                          <button class="primary-action" type="submit" name="decision" value="approve">Aprobar</button>
                          <button class="secondary-button" type="submit" name="decision" value="observe">Observar</button>
                          <button class="danger-button" type="submit" name="decision" value="reject">Rechazar</button>
                        </div>
                      </form>
                    </article>
                  <% }) %>
                </div>
              <% } %>
            </article>

            <article class="tool-panel">
              <div class="tool-header">
                <div>
                  <p class="eyebrow">Trazabilidad reciente</p>
                  <h3>Ultimas decisiones</h3>
                </div>
              </div>

              <div class="tool-card-grid">
                <% recentVerifications.forEach((ticket) => { %>
                  <article class="mini-ticket-card">
                    <div class="request-topline">
                      <strong><%= ticket.ticketCode %></strong>
                      <span class="status-pill status-<%= ticket.statusClass %>"><%= ticket.statusLabel %></span>
                    </div>
                    <p class="request-meta"><%= ticket.person.fullName %></p>
                    <p class="request-notes"><%= ticket.verificationNotes || ticket.rejectionReason || ticket.ticketNotes || "Sin detalle" %></p>
                    <p class="request-time">
                      Verificador:
                      <strong><%= ticket.verifierName || "Pendiente asignacion" %></strong>
                    </p>
                  </article>
                <% }) %>
              </div>
            </article>
          </div>
        </section>
      <% } %>

      <% if (ui.sections.roles) { %>
        <section class="panel-section">
          <div class="section-heading">
            <p class="eyebrow">Mapa de permisos</p>
            <h2>Roles del sistema</h2>
          </div>
          <div class="roles-grid">
            <% roles.forEach((role) => { %>
              <article class="role-card">
                <div class="role-topline">
                  <span class="role-code"><%= role.code %></span>
                  <h3><%= role.name %></h3>
