      <% if (ui.sections.requests && !ui.sections.creatorTools) { %>
        <section class="panel-section">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Escalamiento del operador</p>
              <h2>Solicitudes urgentes</h2>
            </div>
            <p class="section-copy">Bandeja visible para seguimiento operativo de porteria.</p>
