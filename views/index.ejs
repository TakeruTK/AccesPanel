                  <label>
                    <span>Nombre</span>
                    <input id="request-first-name" name="firstName" type="text" value="<%= initialAccessResult.firstName || '' %>" required />
                  </label>
                  <label>
                    <span>Apellido</span>
                    <input id="request-last-name" name="lastName" type="text" value="<%= initialAccessResult.lastName || '' %>" required />
