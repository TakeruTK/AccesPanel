                  <option value="">Todos</option>
                  <% requestStatusOptions.forEach((status) => { %>
                    <option value="<%= status %>" <%= filters.requestStatus === status ? "selected" : "" %>><%= status %></option>
                  <% }) %>
                </select>
              </label>
              <label>
                <span>Desde</span>
                <input name="from" type="date" value="<%= filters.from %>" />
              </label>
              <label>
                <span>Hasta</span>
                <input name="to" type="date" value="<%= filters.to %>" />
              </label>
            </div>
            <div class="action-row">
              <button class="secondary-button" type="submit">Aplicar filtros</button>
              <a class="secondary-link" href="/dashboard">Limpiar</a>
              <a class="secondary-link" href="<%= reportLinks.ticketsCsv %>">Exportar tickets CSV</a>
              <a class="secondary-link" href="<%= reportLinks.accessEventsCsv %>">Exportar accesos CSV</a>
            </div>
          </form>

          <div class="report-stack">
            <article class="tool-panel">
              <div class="tool-header">
                <div>
                  <p class="eyebrow">Accesos registrados</p>
                  <h3>Entrada, salida, lookup y denegaciones</h3>
                </div>
              </div>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th>Fecha</th>
                      <th>Evento</th>
                      <th>Ticket</th>
                      <th>Persona</th>
                      <th>Empresa</th>
                      <th>Origen</th>
                      <th>Operador</th>
                      <th>Notas</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% accessEvents.forEach((event) => { %>
                      <tr>
                        <td><%= event.observedAtLabel %></td>
                        <td><%= event.eventTypeLabel %></td>
                        <td><%= event.ticketCode %></td>
                        <td><%= event.personName %><br /><small><%= event.rut || "Sin RUT" %></small></td>
                        <td><%= event.company %></td>
                        <td><%= event.sourceLabel %></td>
                        <td><%= event.operatorName %></td>
                        <td><%= event.notes %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </article>

            <article class="tool-panel">
              <div class="tool-header">
                <div>
                  <p class="eyebrow">Auditoria</p>
                  <h3>Acciones criticas del sistema</h3>
                </div>
              </div>
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th>Fecha</th>
                      <th>Usuario</th>
                      <th>Accion</th>
                      <th>Entidad</th>
                      <th>Detalle</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% auditLogs.forEach((log) => { %>
                      <tr>
                        <td><%= log.createdAtLabel %></td>
                        <td><%= log.userName %></td>
                        <td><%= log.action %></td>
                        <td><%= log.entityType %><%= log.entityId ? ` #${log.entityId}` : "" %></td>
                        <td><code><%= log.detailsText %></code></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </article>
          </div>
        </section>
      <% } %>
    </div>

    <script>
      (() => {
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute("content");
        if (!csrfToken) {
          return;
        }

        document.querySelectorAll('form[method="post"]').forEach((form) => {
          if (form.querySelector('input[name="csrfToken"]')) {
            return;
          }

          const input = document.createElement("input");
          input.type = "hidden";
          input.name = "csrfToken";
          input.value = csrfToken;
          form.appendChild(input);
        });
      })();
    </script>

    <% if (ui.sections.access) { %>
      <script>
        window.fixAccessInitialResult = <%- serializedInitialAccessResult %>;
        window.fixAccessConfig = {
          defaultVisitDurationHours: <%= Number(systemSettings.OPERATION.defaultVisitDurationHours || 2) %>,
        };
      </script>
      <script src="/app.js"></script>
    <% } %>
  </body>
</html>
