            <div class="quick-actions">
              <% quickChecks.forEach((check) => { %>
                <button class="quick-check" type="button" data-rut="<%= check.rut %>"><%= check.label %></button>
              <% }) %>
            </div>

            <article id="access-result-card" class="access-result access-<%= initialAccessResult.severity %>">
              <div class="access-result-top">
                <span id="result-icon" class="access-icon"><%= initialAccessResult.icon %></span>
                <div>
                  <p id="result-title" class="access-title"><%= initialAccessResult.title %></p>
                  <p id="result-message" class="access-message"><%= initialAccessResult.message %></p>
                </div>
              </div>
              <dl class="access-details">
                <div>
                  <dt>RUT</dt>
                  <dd id="detail-rut"><%= initialAccessResult.rut %></dd>
                </div>
                <div>
                  <dt>Persona</dt>
                  <dd id="detail-person"><%= initialAccessResult.personName %></dd>
                </div>
                <div>
                  <dt>Empresa</dt>
                  <dd id="detail-company"><%= initialAccessResult.company %></dd>
                </div>
                <div>
                  <dt>Ticket</dt>
                  <dd id="detail-ticket"><%= initialAccessResult.ticketCode %></dd>
                </div>
                <div>
                  <dt>Estado</dt>
                  <dd id="detail-status"><%= initialAccessResult.statusLabel %></dd>
                </div>
                <div>
                  <dt>Responsable interno</dt>
                  <dd id="detail-host"><%= initialAccessResult.hostName %></dd>
                </div>
                <div>
                  <dt>Horario autorizado</dt>
                  <dd id="detail-schedule"><%= initialAccessResult.scheduleLabel %></dd>
                </div>
                <div>
                  <dt>Actividad</dt>
                  <dd id="detail-activity"><%= initialAccessResult.activityDescription || "No disponible" %></dd>
                </div>
              </dl>
              <div class="access-footer">
                <span>Accion sugerida</span>
                <strong id="detail-action"><%= initialAccessResult.actionLabel %></strong>
              </div>
            </article>

            <div class="action-row operator-action-row">
              <form id="check-in-form" method="post" action="/operator/check-in">
                <input id="check-in-rut" name="rut" type="hidden" value="<%= initialAccessResult.rut %>" />
                <input id="check-in-ticket-code" name="ticketCode" type="hidden" value="<%= initialAccessResult.ticketCode %>" />
                <input id="check-in-source" name="sourceCode" type="hidden" value="RUT" />
                <button id="check-in-button" class="primary-action" type="submit">Registrar entrada</button>
              </form>
              <form id="check-out-form" method="post" action="/operator/check-out">
                <input id="check-out-rut" name="rut" type="hidden" value="<%= initialAccessResult.rut %>" />
                <input id="check-out-ticket-code" name="ticketCode" type="hidden" value="<%= initialAccessResult.ticketCode %>" />
                <input id="check-out-source" name="sourceCode" type="hidden" value="MANUAL" />
